# Local: dejá DATABASE_URL vacío para usar data/floki.db
DATABASE_URL=

# Generá una clave larga y aleatoria antes de publicar.
FLOKI_SECRET_KEY=reemplazar-por-una-clave-larga-y-unica
FLOKI_ENV=production
FLOKI_SECURE_COOKIES=1

# URL pública, sin barra final. Se usa para los QR.
FLOKI_PUBLIC_URL=https://tu-url.up.railway.app

# Railway asigna PORT automáticamente.
PORT=5000
